route Q1.Emitter to Q2.Base:
    path:
        - [1, 12, 11]
        - [1, 20, 11]
        - [1, 20, 28]
        - [1, 31, 28]
        - [1, 31, 30]

route Q2.Collector to Power.GND:
    path:
        - [1, 30, 33]
        - [1, 30, 40]
        - [2, 30, 40]
